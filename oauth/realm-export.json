{
  "realm": "trogon-eventstore",
  "enabled": true,
  "accessTokenLifespan": 120,
  "requiredActions": [
    {
      "alias": "VERIFY_PROFILE",
      "name": "Verify Profile",
      "providerId": "VERIFY_PROFILE",
      "enabled": false,
      "defaultAction": false,
      "priority": 90
    }
  ],
  "roles": {
    "realm": [
      { "name": "$admins", "composite": false }
    ]
  },
  "clientScopes": [
    {
      "name": "roles",
      "protocol": "openid-connect",
      "attributes": { "include.in.token.scope": "true" },
      "protocolMappers": [
        {
          "name": "roles",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-usermodel-realm-role-mapper",
          "config": {
            "claim.name": "role",
            "multivalued": "true",
            "id.token.claim": "true",
            "access.token.claim": "true",
            "jsonType.label": "String"
          }
        }
      ]
    }
  ],
  "clients": [
    {
      "clientId": "trogon-eventstore-client",
      "enabled": true,
      "publicClient": true,
      "standardFlowEnabled": false,
      "directAccessGrantsEnabled": true,
      "defaultClientScopes": ["roles"],
      "protocolMappers": [
        {
          "name": "audience",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-audience-mapper",
          "config": {
            "included.client.audience": "trogon-eventstore-client",
            "id.token.claim": "false",
            "access.token.claim": "true"
          }
        }
      ]
    }
  ],
  "users": [
    {
      "username": "admin",
      "enabled": true,
      "firstName": "Admin",
      "lastName": "User",
      "requiredActions": [],
      "credentials": [
        { "type": "password", "value": "changeit", "temporary": false }
      ],
      "realmRoles": ["$admins"]
    },
    {
      "username": "noroles",
      "enabled": true,
      "firstName": "No",
      "lastName": "Roles",
      "requiredActions": [],
      "credentials": [
        { "type": "password", "value": "changeit", "temporary": false }
      ],
      "realmRoles": []
    }
  ]
}
